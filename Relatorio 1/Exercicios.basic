dim peso as integer
dim agua as integer
dim meta as integer

print "Digite seu peso:"
input peso

print "Digite a quantidade de agua em ml ingerida hoje"
input agua

meta = peso * 35

if agua >= meta then
    Print "Meta atingida!"
else
    Print "Meta nao atingida"
end if

sleep

